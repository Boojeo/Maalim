# In Claude Code cloud, set these in the cloud environment settings instead of a file.
# Copy to .env.local and fill in. Never commit real keys.

# LLM (leave empty to use the mock adapter)
LLM_PROVIDER=mock            # mock | hosted | allam
LLM_API_KEY=
LLM_MODEL=
ALLAM_ENDPOINT_URL=
ALLAM_API_TOKEN=

# Embeddings (leave empty to use a local/mock embedder)
EMBEDDING_PROVIDER=mock      # mock | hosted  (no runtime model downloads in cloud)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# Supabase (leave empty to use the local JSON fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev flags
DEV_ALLOW_UNVERIFIED=0       # 1 shows unverified passages with a red banner (dev only)
