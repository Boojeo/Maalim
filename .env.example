# In Claude Code cloud, set these in the cloud environment settings instead of a file.
# Copy to .env.local and fill in. Never commit real keys.

# LLM (leave empty to use the mock adapter)
LLM_PROVIDER=mock            # mock | hosted | allam
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=                 # optional; default https://api.openai.com/v1 (OpenAI-compatible) 
LLM_API_STYLE=openai         # openai | anthropic (how LLM_PROVIDER=hosted talks to the API)
LLM_PRICE_IN_PER_MTOK=       # optional USD per 1M input tokens, used only for the cost estimate in EVAL.md
LLM_PRICE_OUT_PER_MTOK=      # optional USD per 1M output tokens
ALLAM_ENDPOINT_URL=
ALLAM_API_TOKEN=
ALLAM_MODEL=

# Embeddings (leave empty to use a local/mock embedder)
EMBEDDING_PROVIDER=mock      # mock | hosted  (no runtime model downloads in cloud)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3
EMBEDDING_API_URL=           # optional; OpenAI-compatible /embeddings endpoint

# Supabase (leave empty to use the local JSON fallback)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dev flags
DEV_ALLOW_UNVERIFIED=0       # 1 shows unverified passages with a red banner (dev only)

# Access tokens for /admin/review and the mentor dashboard. If unset: open in dev, CLOSED in production.
ADMIN_TOKEN=
MENTOR_TOKEN=

# Demo mode (production-allowed, shows a permanent DEMO banner): wudu clip with draft captions and step-order questions.
# Leave unset/0 for the real, review-gated behaviour. Future-work topics are controlled by FUTURE_CONCEPTS (default: all except wudu).
DEMO_CONTENT=0
